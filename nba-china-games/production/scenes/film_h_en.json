 "vo": [
  {
   "id": "L01",
   "t": 4.0,
   "dur": 1.24,
   "text": "Tonight. Macau."
  },
  {
   "id": "L02",
   "t": 5.6,
   "dur": 2.75,
   "text": "Over ten thousand lights. All for one ball."
  },
  {
   "id": "L03",
   "t": 9.7,
   "dur": 4.68,
   "text": "That ball first touched a court in China forty-seven years ago."
  },
  {
   "id": "L04",
   "t": 14.6,
   "dur": 2.12,
   "text": "Summer, 1979."
  },
  {
   "id": "L05",
   "t": 16.9,
   "dur": 2.13,
   "text": "Diplomatic ties: six months old."
  },
  {
   "id": "L06",
   "t": 19.4,
   "dur": 3.0,
   "text": "A team of NBA champions stepped off a plane."
  },
  {
   "id": "L07",
   "t": 22.6,
   "dur": 3.56,
   "text": "They had seen the biggest arenas. The toughest opponents."
  },
  {
   "id": "L08",
   "t": 28.8,
   "dur": 1.71,
   "text": "But in Beijing, they looked up."
  },
  {
   "id": "L09",
   "t": 32.2,
   "dur": 2.83,
   "text": "Seven-foot-six. Mu Tiezhu."
  },
  {
   "id": "L10",
   "t": 41.799,
   "dur": 5.8,
   "text": "Ten years later, an American waited nearly an hour in a guard booth at China's state television."
  },
  {
   "id": "L11",
   "t": 48.599,
   "dur": 1.97,
   "text": "His name: David Stern."
  },
  {
   "id": "L12",
   "t": 51.399,
   "dur": 1.48,
   "text": "All he had was a videotape."
  },
  {
   "id": "L13",
   "t": 59.279,
   "dur": 3.07,
   "text": "And a generation discovered basketball on tape."
  },
  {
   "id": "L14",
   "t": 66.479,
   "dur": 3.8,
   "text": "In 2002, that generation produced a giant."
  },
  {
   "id": "L15",
   "t": 73.679,
   "dur": 3.88,
   "text": "October 14, 2004. Shanghai."
  },
  {
   "id": "L16",
   "t": 77.679,
   "dur": 2.68,
   "text": "The first NBA game ever played in China."
  },
  {
   "id": "L18",
   "t": 99.639,
   "dur": 3.72,
   "text": "A Rockets executive called it the Beatles meets Michael Jordan."
  },
  {
   "id": "L19",
   "t": 104.539,
   "dur": 1.16,
   "text": "The next fifteen years."
  },
  {
   "id": "L20",
   "t": 106.639,
   "dur": 2.29,
   "text": "Seventeen teams. Twenty-eight games."
  },
  {
   "id": "L21a",
   "t": 111.513,
   "dur": 1.0,
   "text": "LeBron came."
  },
  {
   "id": "L21b",
   "t": 118.99,
   "dur": 0.92,
   "text": "Kobe came."
  },
  {
   "id": "L22",
   "t": 122.194,
   "dur": 1.72,
   "text": "Even Michael Jordan came."
  },
  {
   "id": "L23",
   "t": 131.429,
   "dur": 1.48,
   "text": "Then, the lights went out."
  },
  {
   "id": "L24",
   "t": 140.729,
   "dur": 3.72,
   "text": "2,190 days. Not a single China Game."
  },
  {
   "id": "L25",
   "t": 148.129,
   "dur": 1.79,
   "text": "But the ball never stopped bouncing."
  },
  {
   "id": "L26",
   "t": 154.329,
   "dur": 2.19,
   "text": "2025. Macau."
  },
  {
   "id": "L27",
   "t": 157.609,
   "dur": 0.5,
   "text": "It's back."
  },
  {
   "id": "L28",
   "t": 169.329,
   "dur": 1.88,
   "text": "This year, the Rockets return."
  },
  {
   "id": "L29",
   "t": 172.729,
   "dur": 1.4,
   "text": "The team that started it all."
  },
  {
   "id": "L30",
   "t": 187.579,
   "dur": 3.0,
   "text": "Forty-seven years. And the ball keeps bouncing."
  }
 ],
