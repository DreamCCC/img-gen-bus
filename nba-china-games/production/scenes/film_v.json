 "vo": [
  {
   "id": "V01",
   "t": 0.15,
   "dur": 4.73,
   "text": "一九八九年，NBA总裁在央视传达室，等了将近一个小时。",
   "wav": "audio/vo_v/V01.wav"
  },
  {
   "id": "V02",
   "t": 5.85,
   "dur": 2.15,
   "text": "就为了，送出一盘录像带。",
   "wav": "audio/vo_v/V02.wav"
  },
  {
   "id": "V03",
   "t": 8.45,
   "dur": 3.85,
   "text": "其实早在一九七九年，NBA总冠军就来过中国。",
   "wav": "audio/vo_v/V03.wav"
  },
  {
   "id": "V04",
   "t": 13.45,
   "dur": 3.62,
   "text": "在北京，他们仰头看见了两米二八的穆铁柱。",
   "wav": "audio/vo_v/V04.wav"
  },
  {
   "id": "V05",
   "t": 17.75,
   "dur": 5.24,
   "text": "二零零四年，NBA第一次在中国打正式比赛。主角，是姚明。",
   "wav": "audio/vo_v/V05.wav"
  },
  {
   "id": "L18",
   "t": 25.3,
   "dur": 3.18,
   "text": "斯特恩说：这里，像披头士的演唱会。",
   "wav": "audio/vo/L18.wav"
  },
  {
   "id": "V07",
   "t": 29.15,
   "dur": 3.43,
   "text": "此后十五年，十七支球队，二十八场比赛。",
   "wav": "audio/vo_v/V07.wav"
  },
  {
   "id": "V08",
   "t": 33.047,
   "dur": 2.5,
   "text": "詹姆斯、科比、乔丹，都来了。",
   "wav": "audio/vo_v/V08.wav"
  },
  {
   "id": "V09",
   "t": 38.474,
   "dur": 2.0,
   "text": "然后，中国赛暂停了。",
   "wav": "audio/vo_v/V09.wav"
  },
  {
   "id": "V10",
   "t": 41.174,
   "dur": 1.78,
   "text": "一停，就是六年。",
   "wav": "audio/vo_v/V10.wav"
  },
  {
   "id": "L27",
   "t": 44.624,
   "dur": 0.77,
   "text": "它回来了。",
   "wav": "audio/vo/L27.wav"
  },
  {
   "id": "L28",
   "t": 50.174,
   "dur": 1.91,
   "text": "今年，回来的是火箭。",
   "wav": "audio/vo/L28.wav"
  },
  {
   "id": "V14",
   "t": 57.274,
   "dur": 3.01,
   "text": "四十七年，球一直在跳。澳门，见。",
   "wav": "audio/vo_v/V14.wav"
  }
 ],
