[
 {"id": "L01", "voice": "longfei_v3", "mood": "normal", "text": "今晚，澳门。"},
 {"id": "L02", "voice": "longfei_v3", "mood": "normal", "text": "一万多盏灯，为同一颗球亮起。"},
 {"id": "L03", "voice": "longfei_v3", "mood": "normal", "text": "而这颗球，第一次落在中国的地板上——是四十七年前。", "say": "而这颗球，第一次落在中国的地板上，是四十七年前。"},
 {"id": "L04", "voice": "longfei_v3", "mood": "normal", "text": "一九七九年，夏天。"},
 {"id": "L05", "voice": "longfei_v3", "mood": "normal", "text": "中美建交，刚满半年。"},
 {"id": "L06", "voice": "longfei_v3", "mood": "normal", "text": "一支NBA总冠军，走下了飞机。"},
 {"id": "L07", "voice": "longfei_v3", "mood": "normal", "text": "他们见过最大的球馆，最强的对手。"},
 {"id": "L08", "voice": "longfei_v3", "mood": "normal", "text": "却在北京，仰起了头。"},
 {"id": "L09", "voice": "longfei_v3", "mood": "hype", "text": "两米二八。穆铁柱。", "say": "两米二八！穆铁柱！"},
 {"id": "L10", "voice": "longfei_v3", "mood": "normal", "text": "十年后，一个美国人，在央视东门的传达室，坐了将近一个小时。"},
 {"id": "L11", "voice": "longfei_v3", "mood": "normal", "text": "他叫斯特恩。"},
 {"id": "L12", "voice": "longfei_v3", "mood": "normal", "text": "他手里，只有一盘录像带。"},
 {"id": "L13", "voice": "longfei_v3", "mood": "normal", "text": "于是，一代人在录像带里，认识了篮球。"},
 {"id": "L14", "voice": "longfei_v3", "mood": "hype", "text": "二零零二年，那代人里，走出了一个巨人。", "say": "二零零二年，那代人里，走出了一个巨人！"},
 {"id": "L15", "voice": "longfei_v3", "mood": "normal", "text": "二零零四年十月十四日，上海。"},
 {"id": "L16", "voice": "longfei_v3", "mood": "hype", "text": "NBA，第一次在中国打正式比赛。", "say": "NBA，第一次在中国打正式比赛！"},
 {"id": "L18", "voice": "longfei_v3", "mood": "hype", "text": "斯特恩说：这里，像披头士的演唱会。", "say": "斯特恩说：这里，像披头士的演唱会！"},
 {"id": "L19", "voice": "longfei_v3", "mood": "hype", "text": "此后十五年。", "say": "此后十五年！"},
 {"id": "L20", "voice": "longfei_v3", "mood": "hype", "text": "十七支球队，二十八场比赛。", "say": "十七支球队！二十八场比赛！"},
 {"id": "L21a", "voice": "longfei_v3", "mood": "hype", "text": "詹姆斯来了。", "say": "詹姆斯来了！"},
 {"id": "L21b", "voice": "longfei_v3", "mood": "hype", "text": "科比来了。", "say": "科比来了！"},
 {"id": "L22", "voice": "longfei_v3", "mood": "hype", "text": "连乔丹，也来了。", "say": "连乔丹，也来了！"},
 {"id": "L23", "voice": "longfei_v3", "mood": "quiet", "rate": 0.8, "text": "然后，灯，灭了。"},
 {"id": "L24", "voice": "longfei_v3", "mood": "quiet", "rate": 0.85, "text": "两千一百九十天，没有一场中国赛。"},
 {"id": "L25", "voice": "longfei_v3", "mood": "quiet", "rate": 0.9, "text": "但球，一直在弹。"},
 {"id": "L26", "voice": "longfei_v3", "mood": "hype", "text": "二零二五年，澳门。", "say": "二零二五年，澳门！"},
 {"id": "L27", "voice": "longfei_v3", "mood": "hype", "text": "它回来了。", "say": "它回来了！"},
 {"id": "L28", "voice": "longfei_v3", "mood": "hype", "text": "今年，回来的是火箭。", "say": "今年，回来的是火箭！"},
 {"id": "L29", "voice": "longfei_v3", "mood": "hype", "text": "那支，开启了一切的球队。", "say": "那支，开启了一切的球队！"},
 {"id": "L30", "voice": "longfei_v3", "mood": "normal", "rate": 0.9, "text": "四十七年。球，一直在跳。"}
]
